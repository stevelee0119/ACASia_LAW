+class TestTK139RedosJ15(unittest.TestCase):
+    def test_j15_normalizers_linear_on_adversarial_input(self):
+        """CodeQL py/redos(인용구 정규식)·형식어 정규식의 긴 반복 입력에서 처리 시간이 입력 길이에 비례한다."""
