+"""EV-1(TK-76 잔여): 지각 범위 같은 문장 규칙의 어미·낱말 일반화(평가 측 합성 문장. 탐침 문장 아님).
+
+경험 부정('-ㄴ 적이 없'), 닫힘 서술형·내부 노출 부정, 장소 출입 낱말, 의식 회복 부정, 머무름 연결형+양보,
+'소리만' 뒤 다른 서술어와 '눈으로·육안으로' 시각 주장. 대조는 매개 경로·다른 주어·옮긴 말·투명 창·연 뒤 관찰·
+같은 장소·소리 뒤 다가가 확인·지각 주장 없음.
+"""
+import pytest
+
+from packages.claim_engine.evidence_consistency import perception_conflict
+
+POSITIVE = [("UNOPENED_INSIDE","저는 그 서랍을 열어 본 적이 없지만 그 안에 있던 계약서의 날짜를 읽었습니다."),
+("UNOPENED_INSIDE","증인은 봉투를 개봉한 일이 없었는데도 그 속의 사진을 직접 확인했습니다."),
+("CLOSED_INSIDE","창고 문이 닫혀 있어 안이 보이지 않았지만 저는 그 안에서 직원이 상자를 옮기는 것을 직접 보았습니다."),
+("CLOSED_INSIDE","금고가 잠겨 있었는데도 저는 그 내부의 현금 다발을 똑똑히 보았습니다."),
+("NEVER_PRESENT","저는 그 사무실에 한 번도 들어가 본 적이 없지만 대표가 서류를 찢는 장면을 직접 보았습니다."),
+("NEVER_PRESENT","증인은 공장에 출입한 적이 없었는데도 기계가 멈춘 모습을 분명히 목격하였습니다."),
+("INCAPACITATED","저는 수술 뒤 의식이 돌아오지 않았는데 그사이 의사가 보호자에게 한 설명을 들었습니다."),
+("INCAPACITATED","본인은 정신을 차리지 못한 상태에서 상대방이 차를 몰고 떠나는 것을 보았습니다."),
+("ELSEWHERE_SAME_TIME","저는 그 시각 집에 머물면서 아무 연락도 받지 않았는데도, 같은 시각 사무실에서 팀장이 한 말을 제 귀로 들었습니다."),
+("ELSEWHERE_SAME_TIME","증인은 서울 본사에 있으면서 외부와 통화하지 않았지만 같은 시각 부산 지점에서 오간 대화를 직접 들었습니다."),
+("SOUND_ONLY_VISUAL","벽 너머에서 고함 소리만 들렸고 아무것도 보지 못했지만 저는 그 사람이 흰 셔츠를 입은 것을 눈으로 확인했습니다."),
+("SOUND_ONLY_VISUAL","밖에서 차 소리만 났을 뿐인데 저는 운전자의 얼굴을 육안으로 보았습니다.")]
+CONTROL = ["저는 서랍을 열어 본 적이 없어서 그 안에 무엇이 있었는지 모릅니다.",
+"봉투를 개봉한 적은 없지만 겉면에 적힌 주소는 직접 읽었습니다.",
+"창고 문이 닫혀 있어 안이 보이지 않았지만 안에서 나는 소리는 직접 들었습니다.",
+"금고는 잠겨 있었으나 문의 유리창 너머로 그 안의 서류를 직접 보았습니다.",
+"창고 문이 닫혀 있었고, 직원이 문을 열어 준 뒤 그 안에서 상자를 직접 보았습니다.",
+"저는 그 사무실에 들어가 본 적이 없지만 대표가 서류를 찢었다는 말은 동료에게서 전해 들었습니다.",
+"저는 그 공장에 출입한 적이 없지만 기계가 멈췄다는 보도를 보았습니다.",
+"환자는 의식이 돌아오지 않았는데 저는 곁에서 의사의 설명을 들었습니다.",
+"저는 의식이 돌아오지 않았다고 간호사에게서 들었습니다.",
+"저는 집에 머물면서 같은 시각 집 안에서 아이가 우는 소리를 직접 들었습니다.",
+"저는 사무실에 있으면서 창밖을 보지 않았지만, 같은 시각 사무실에서 동료가 한 말은 직접 들었습니다.",
+"고함 소리만 들렸고 이후 방에 들어가 그 사람이 흰 셔츠를 입은 것을 눈으로 확인했습니다.",
+"밖에서 차 소리만 났고 누가 왔는지는 보지 못했습니다.",
+"당시 저는 편의점 앞에 있으면서, 그때 사고 장면을 직접 보았습니다.",
+"그 서랍은 잠겨 있어 안이 보이지 않았고 내용물은 확인하지 못했습니다.",
+"제 사무실 문은 닫혀 있었지만 저는 사무실 안에서 회의 내용을 직접 들었습니다."]
+
+
+@pytest.mark.parametrize("pattern,sentence", POSITIVE)
+def test_generalized_forms_are_found(pattern, sentence):
+    assert perception_conflict(sentence) == pattern
+
+
+@pytest.mark.parametrize("sentence", CONTROL)
+def test_generalized_controls_are_not_flagged(sentence):
+    assert perception_conflict(sentence) is None
