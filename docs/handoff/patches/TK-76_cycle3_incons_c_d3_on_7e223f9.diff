+        m = pat.search(verb)
+        if m and not re.fullmatch(r"[가-힣]{2}", m.group(0)):
+            return stage_name
+    return _DEFAULT_NOUN_STAGE.get((head_noun or "").rstrip("서"), "NOTIFY_SEND")
+
