+# 엔진 문장 속 소문자 식별자(검사 층·필드·출처 이름).
+FIELD_WORDS: Dict[str, str] = {
+    "visible_text": "본문",
+    "encoded_text": "인코딩된 문자열",
+    "hidden_text": "숨김 글자",
