+                or (re.search(r"(?<![가-힣])각(?:각)?(?![가-힣])", text[ops[0]["end"]:ops[1]["start"]])
+                    and re.search(r"씩", text[ops[1]["start"]:ops[1]["end"] + 2]))):
+            return ops[0]["val"] * ops[1]["val"], "*"
         if re.search(f"{_SUB_PRED}|제외하[면여]", after_ops):
             return ops[0]["val"] - ops[1]["val"], "-"
