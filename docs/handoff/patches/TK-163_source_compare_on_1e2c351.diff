+        note = f" — {row['claim_verdict_note']}" if row.get("claim_verdict_note") else ""
+        lines.append(f"[근거 판정] {row['claim_verdict_label']}{note}")
+    cid = row.get("citation_id")
+    if cid:
+        for item in value(document, "review_items", []) or []:
