+def _infer_abbreviation(verifier, verdict, citation, as_of, current_date):
+    """문서에 정식 법령명이 없을 때 공식 목록에서 약칭 후보를 하나로 좁혀 다시 조회한다(TK-130)."""
+    infer = getattr(verifier.registry.law, "infer_law_by_abbreviation", None)
