@@ -560,6 +562,15 @@ def _law_absent(verdict, response, verifier=None):
 UNDECIDED_INFERENCE = ("AMBIGUOUS", "INCOMPLETE", "LOOKUP_FAILED", "ARTICLE_NOT_IN_CANDIDATE")
 
 
+def _undecided_inference(law_name: str, alias) -> bool:
+    """약칭 추정이 결론을 내지 못했는지. 두 음절 어간은 후보 0건도 미결이다(TK-152 (d)): 공식 약칭이 앞 낱말을 생략한
+    꼴이면 첫 글자 초성 목록에 들어 있지 않아, 그 목록에 후보가 없다는 것이 부존재 근거가 되지 못한다."""
+    from .law_name_inference import SHORT_STEM, compact, stem
+
+    outcome = (alias or {}).get("outcome")
+    return outcome in UNDECIDED_INFERENCE or (outcome == "NO_CANDIDATE" and len(stem(compact(law_name))) == SHORT_STEM)
+
+
 def _abbreviation_like(law_name: str) -> bool:
     """어간(끝의 법·시행령·시행규칙을 뗀 몸통)이 2~3자이고 공백 없는 이름 — 실무 줄임말 꼴(TK-143)."""
     from .law_name_inference import compact, stem
