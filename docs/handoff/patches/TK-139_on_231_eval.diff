+def disposition_line(crit: Dict[str, Any], sep: str = " · ") -> str:
+    """처분기준 대조 한 줄(화면·보고서 같은 문구): 법령 [별표 N] · 업종 · N차 위반: 별표 … / 서면 … → 결과 · 감경 · 검토 자료."""
