+def test_brand_text_and_self_hosted_pretendard():
+    html = (ROOT / "apps/web/index.html").read_text(encoding="utf-8")
+    assert "ACASia" not in html and "ACASia" not in (STATIC / "operations.js").read_text(encoding="utf-8")
