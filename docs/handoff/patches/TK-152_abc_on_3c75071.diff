diff --git a/tests/test_tk152_short_abbreviation_ranking.py b/tests/test_tk152_short_abbreviation_ranking.py
new file mode 100644
index 0000000..ee77851
--- /dev/null
+++ b/tests/test_tk152_short_abbreviation_ranking.py
@@ -0,0 +1,68 @@
+"""TK-152: 두 음절 어간 약칭의 후보 순위와, 추정 후보에 인용 조문이 없을 때의 판정.
+
+합성 법령명만 쓴다(실제 법령·서면의 이름이 아니다). TK-130 시험의 목록·본문 흉내를 그대로 쓴다.
+"""
+import test_tk130_abbreviation_inference as t130
+from test_tk130_abbreviation_inference import adapter  # noqa: F401  (fixture 재사용)
+from packages.legal_engine.law_name_inference import SHORT_STEM, pick
+from packages.source_adapters.law_go_kr import _normalize_law_payload
+
+
+def records(*rows):
+    return _normalize_law_payload({"LawSearch": {"law": list(rows)}})
+
+
+def chosen_name(written, *rows):
+    chosen, _ = pick(written, records(*rows), min_stem=SHORT_STEM)
+    return chosen and chosen["law_name"]
+
+
+def kinds(verdict):
+    return {f.confidence_features.get("verdict_label") for f in verdict.findings}
+
+
+def test_official_abbreviation_bonus_does_not_beat_first_two_word_initials():
+    # 공식 약칭이 있다는 이유만으로, 글자가 떨어져 맞는 약칭(셋째 말마디 이후)이 첫 두 말마디가 맞는 정식명을 앞서지 않는다.
+    right = t130.row(name="시험안전관리법", law_id="000911", mst="911")
+    wrong = t130.row(name="시험전환에 따른 고용안정 지원법", law_id="000912", mst="912", 법령약칭명="시험전환고용안정법")
+    assert chosen_name("시안법", right, wrong) == "시험안전관리법"
+
+
+def test_contiguous_prefix_of_official_abbreviation_wins():
+    right = t130.row(name="시험재해보상보험법", law_id="000913", mst="913", 법령약칭명="시재보험법")
+    other = t130.row(name="시험재산 정보의 관리에 관한 법률", law_id="000914", mst="914", 법령약칭명="시업재산정보법")
+    assert chosen_name("시재법", right, other) == "시험재해보상보험법"
+
+
+def test_rules_and_other_non_statute_names_are_not_candidates_for_a_statute():
+    statute = t130.row(name="시험안전보건법", law_id="000915", mst="915")
+    rule = t130.row(name="시험안전기준에 관한 규칙", law_id="000916", mst="916")
+    assert chosen_name("시안법", statute, rule) == "시험안전보건법"
+
+
+def test_same_grade_candidates_stay_ambiguous():
+    a = t130.row(name="시험보험법", law_id="000917", mst="917")
+    b = t130.row(name="시험정책 기본법", law_id="000918", mst="918")
+    chosen, ranked = pick("시험법", records(a, b), min_stem=SHORT_STEM)
+    assert chosen is None and len(ranked) == 2
+
+
+def test_candidate_without_cited_article_is_unverified_not_critical(monkeypatch, adapter):
+    # 우선 후보는 골랐으나 그 법령 조회 버전에 인용 조문이 없으면 추정이 틀렸을 수 있다 → 부존재로 단정하지 않는다.
+    rows = [t130.row()]
+    t130.install(monkeypatch, adapter, lambda params: rows if params.get("gana") else t130.by_stem(rows)(params),
+                 article="6")
+    verdict = t130.verify(adapter, t130.cite("시재법", article="99"))
+    assert verdict.review["law_alias"]["outcome"] == "ARTICLE_NOT_IN_CANDIDATE"
+    assert "NOT_FOUND_LAW" not in kinds(verdict)
+    [f] = [f for f in verdict.findings if f.confidence_features.get("verdict_label") == "ABBREVIATION_UNRESOLVED"]
+    assert str(f.severity) == "MEDIUM" and str(f.status) == "UNVERIFIED"
+    assert "인용 조문이 없어" in f.detail and t130.FULL in f.detail
+
+
+def test_long_stem_candidate_without_article_keeps_existing_result(monkeypatch, adapter):
+    # 어간 4자 이상(약칭 꼴 아님)은 기존 판정 유지(TK-130 대조).
+    rows = [t130.row(법령약칭명="시험재해처벌법")]
+    t130.install(monkeypatch, adapter, t130.by_stem(rows), article="6")
+    verdict = t130.verify(adapter, t130.cite("시험재해법", article="99"))
+    assert "NOT_FOUND_LAW" in kinds(verdict)
