+def _short_score(q: str, record: Dict[str, Any]) -> int:
+    """두 음절 어간 줄임말의 점수(TK-152). 대조 대상은 지금처럼 공식 약칭(없으면 정식명)이고, 점수는 둘에 같은 기준을 쓴다.
+
+    정렬 등급: 어간이 대상 어간의 맨 앞에 그대로 이어 나옴(1000) > 둘째 글자가 둘째 말마디 첫 음절(850)
+    > 그 밖의 말마디 첫 음절 정렬(700). 같은 등급이면 짧은 대상이 앞선다. 약칭이라고 가산하지 않는다
+    (약칭 가산 때문에 글자가 떨어져 맞는 다른 법률의 약칭이 정식명 첫 두 말마디가 맞는 법률을 앞섰다).
+    법률(…법)로 적힌 이름은 이름이 '법'·'법률'로 끝나는 대상만 본다('…에 관한 규칙' 등 제외).
+    """
+    qs, kind = stem(q), law_kind(q)
+    target = compact(record.get("abbreviation")) or compact(record.get("law_name"))
+    if not target or target == q or law_kind(target) != kind or target[0] != q[0]:
+        return 0
+    if kind == "법률" and not re.search(r"(법|법률)$", target):
+        return 0
+    ts = stem(target)
+    if ts.startswith(qs):
+        tier = 1000
+    elif len(ts) > 2 and ts[2] == qs[1]:
+        tier = 850
+    elif _initials_subsequence(qs, ts):
+        tier = 700
+    else:
+        return 0
+    return tier - min(len(ts) - len(qs), 100)
+
+
 def score(written: str, record: Dict[str, Any], *, min_stem: int = MIN_STEM) -> int:
     q = compact(written)
     if len(stem(q)) < min_stem:
         return 0
+    if min_stem == SHORT_STEM and len(stem(q)) == SHORT_STEM:
+        return _short_score(q, record)
     abbreviation = compact(record.get("abbreviation"))
     target = abbreviation or compact(record.get("law_name"))
     if not target or law_kind(target) != law_kind(q) or target[0] != q[0]:
         return 0
     if target == q or not is_subsequence(q, target):
         return 0
-    if min_stem == SHORT_STEM and len(stem(q)) == SHORT_STEM and not (
-            _initials_subsequence(stem(q), stem(target)) or stem(target).startswith(stem(q))):
-        return 0                       # 두 음절 줄임말: 말마디 첫 음절이거나 정식명 첫 낱말 그대로(TK-143)
     base = 800 if abbreviation else 600
     return base - min(len(target) - len(q), 200 if not abbreviation else 100)
 
