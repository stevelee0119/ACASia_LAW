+
+
+def judge_claim_against_sources(claim_text, sources, router, *, policy, korean_profile=False, reference_date=None):
+    """구성요소 시험용 진입점(BM-2): 주장 문장 하나와 참고자료를 운영과 같은 요청·스키마·근거 검증으로 판정한다.
+
+    문서 선정·관련성 문턱·분할·재시도는 하지 않는다(그것은 review_document의 몫). 법률 판단을 덧붙이지 않는다.
+    반환: {"status": OK|NO_PROVIDER|MODEL_FAILED|REJECTED, "observations": [...], "rejected": [...], "executions": [...]}.
+    """
+    if not router.has_available_provider(policy=policy):
+        return {"status": "NO_PROVIDER", "observations": [], "rejected": [], "executions": []}
+    request = build_review_request(claim_text, sources, korean_profile=korean_profile, reference_date=reference_date)
+    outcome = asyncio.run(router.run(LLMRole.PRIMARY_REASONER, request, policy=policy, expected_task="참고자료 검토"))
+    executions = [e.to_dict() for e in outcome.executions]
+    if not outcome.used or outcome.quarantined:
+        return {"status": "MODEL_FAILED", "observations": [], "rejected": [], "executions": executions}
+    rejected = []
+    observations = grounded_observations(outcome.parsed, claim_text, sources, rejected=rejected)
+    return {"status": "OK" if observations is not None else "REJECTED", "observations": observations or [],
+            "rejected": rejected, "executions": executions}
+
+
 def grounded_observations(parsed, document, sources, *, rejected=None):
     try:
         validate(parsed, ENVELOPE_SCHEMA)
