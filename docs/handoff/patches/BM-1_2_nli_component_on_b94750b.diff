diff --git a/tests/test_bm1_nli_scoring.py b/tests/test_bm1_nli_scoring.py
new file mode 100644
index 0000000..40c74a5
--- /dev/null
+++ b/tests/test_bm1_nli_scoring.py
@@ -0,0 +1,86 @@
+"""BM-1: 주장–문서 관계(ContractNLI 꼴) 3분류·근거 구간 채점(합성 값, 모델 호출 없음)."""
+import pytest
+
+from packages.evaluation import NLILabel, NLIPrediction, evaluate_nli
+
+REV = "rev-1"
+
+
+def L(i, label, spans=(), fam=None, split="TEST", doc=None):
+    return NLILabel(item_id=i, benchmark_id="contractnli", benchmark_revision=REV, document_id=doc or ("d" + i),
+                    case_family_id=fam or ("f" + i), hypothesis_id="h1", split=split, label=label, spans=list(spans))
+
+
+def P(i, label=None, spans=(), status="OK", sv="sha1", rev=REV):
+    return NLIPrediction(item_id=i, run_id="r1", system_version=sv, benchmark_revision=rev, execution_status=status,
+                         label=label, spans=list(spans))
+
+
+GOLD = [L("a", "ENTAILMENT", [(0, 10)]), L("b", "CONTRADICTION", [(5, 15)]), L("c", "NOT_MENTIONED"), L("d", "ENTAILMENT", [(0, 4)])]
+
+
+def test_perfect_predictions():
+    r = evaluate_nli(GOLD, [P("a", "ENTAILMENT", [(0, 10)]), P("b", "CONTRADICTION", [(5, 15)]), P("c", "NOT_MENTIONED"),
+                            P("d", "ENTAILMENT", [(0, 4)])], bootstrap_samples=100)
+    m = r["metrics"]
+    assert m["macro_f1"] == 1.0 and m["accuracy"] == 1.0 and m["span"]["f1"] == 1.0 and m["missing_or_failed"] == 0
+
+
+def test_missing_and_failed_stay_in_denominator_and_are_not_not_mentioned():
+    r = evaluate_nli(GOLD, [P("a", status="ERROR"), P("c", status="UNSUPPORTED")], bootstrap_samples=100)
+    m = r["metrics"]
+    assert m["items"] == 4 and m["missing_or_failed"] == 4 and m["completeness"] == 0
+    assert m["confusion"]["NOT_MENTIONED"]["MISSING"] == 1 and m["per_class"]["NOT_MENTIONED"]["tp"] == 0
+    assert m["accuracy"] == 0 and m["span"]["recall"] == 0
+
+
+def test_span_only_counts_when_relation_matches():
+    r = evaluate_nli([L("a", "ENTAILMENT", [(0, 10)])], [P("a", "CONTRADICTION", [(0, 10)])], bootstrap_samples=100)
+    assert r["metrics"]["span"]["recall"] == 0 and r["metrics"]["span"]["precision"] is None
+
+
+def test_partial_span_overlap():
+    r = evaluate_nli([L("a", "ENTAILMENT", [(0, 10)])], [P("a", "ENTAILMENT", [(5, 15)])], bootstrap_samples=100)
+    assert r["metrics"]["span"]["precision"] == 0.5 and r["metrics"]["span"]["recall"] == 0.5
+
+
+@pytest.mark.parametrize("preds,error", [
+    ([P("a", "ENTAILMENT"), P("a", "ENTAILMENT")], "Duplicate prediction"),
+    ([P("zz", "ENTAILMENT")], "no label"),
+    ([P("a", "ENTAILMENT", rev="rev-2")], "benchmark revisions"),
+    ([P("a", "ENTAILMENT", sv="s1"), P("b", "CONTRADICTION", sv="s2")], "runs or system versions"),
+])
+def test_rejected_inputs(preds, error):
+    with pytest.raises(ValueError, match=error):
+        evaluate_nli(GOLD, preds, bootstrap_samples=100)
+
+
+def test_family_split_leak_rejected():
+    with pytest.raises(ValueError, match="Split leakage"):
+        evaluate_nli([L("a", "NOT_MENTIONED", fam="x"), L("b", "NOT_MENTIONED", fam="x", split="DEVELOPMENT")], [],
+                     bootstrap_samples=100)
+
+
+@pytest.mark.parametrize("kwargs", [
+    {"label": "NOT_MENTIONED", "spans": [(0, 3)]},   # 근거 없는 '언급 없음'에 구간이 붙으면 거절
+    {"label": "ENTAILMENT", "spans": [(5, 5)]},      # 빈 구간
+    {"label": "ENTAILMENT", "spans": [(0, 5), (3, 8)]},  # 겹침
+])
+def test_invalid_gold(kwargs):
+    with pytest.raises(ValueError):
+        NLILabel(item_id="x", benchmark_id="b", benchmark_revision=REV, document_id="d", case_family_id="f",
+                 hypothesis_id="h", split="TEST", **kwargs)
+
+
+def test_ok_prediction_requires_label_and_error_has_none():
+    with pytest.raises(ValueError):
+        P("a", None, status="OK")
+    with pytest.raises(ValueError):
+        P("a", "ENTAILMENT", status="ERROR")
+
+
+def test_interval_resamples_case_families_and_scope_notice():
+    gold = [L(str(i), "ENTAILMENT", [(0, 2)], fam="fam" + str(i // 3)) for i in range(9)]
+    r = evaluate_nli(gold, [P(str(i), "ENTAILMENT", [(0, 2)]) for i in range(9)], bootstrap_samples=200, seed=1)
+    assert r["uncertainty"]["independent_case_families"] == 3
+    assert r["claim_scope"] == "CLAIM_DOCUMENT_RELATION_ONLY" and "Korean-law" in r["notice"]
diff --git a/tests/test_bm2_component_entry.py b/tests/test_bm2_component_entry.py
new file mode 100644
index 0000000..3812159
--- /dev/null
+++ b/tests/test_bm2_component_entry.py
@@ -0,0 +1,60 @@
+"""BM-2: 참고자료 대조 판정의 구성요소 진입점 — 운영과 같은 요청·근거 검증을 쓴다(가짜 라우터, 네트워크 없음)."""
+import json
+from types import SimpleNamespace
+
+from packages.common.enums import LLMRole
+from packages.rag_engine import review
+from packages.rag_engine.review import build_review_request, judge_claim_against_sources
+
+SOURCES = [{"source_id": "R1", "title": "합성 계약", "text": "수령자는 비밀정보를 제3자에게 공개하여서는 아니 된다.", "page": 1}]
+CLAIM = "수령자는 비밀정보를 공개할 수 없다는 합성 주장이다."
+
+
+class FakeRouter:
+    def __init__(self, parsed, used=True, quarantined=False, available=True):
+        self.parsed, self.used, self.quarantined, self.available, self.calls = parsed, used, quarantined, available, []
+
+    def has_available_provider(self, policy=None):
+        return self.available
+
+    async def run(self, role, request, **kwargs):
+        self.calls.append((role, request, kwargs))
+        return SimpleNamespace(used=self.used, quarantined=self.quarantined, parsed=self.parsed, executions=[])
+
+
+def obs(rel, claim=CLAIM, quote="비밀정보를 제3자에게 공개하여서는 아니 된다"):
+    return {"observations": [{"claim_quote": claim, "source_id": "R1", "source_quote": quote, "relationship": rel,
+                              "explanation": "합성 설명"}]}
+
+
+def test_same_request_as_production():
+    request = build_review_request(CLAIM, SOURCES, batch=1)
+    body = json.loads(request.user)
+    assert request.system == review.RAG_REVIEW_SYSTEM_PROMPT and request.schema == review.ENVELOPE_SCHEMA
+    assert body["document"] == CLAIM and body["untrusted_references"][0]["source_id"] == "R1"
+    assert request.input_contract == "reference_review_v1"
+
+
+def test_grounded_observation_is_returned():
+    router = FakeRouter(obs("SUPPORTS"))
+    got = judge_claim_against_sources(CLAIM, SOURCES, router, policy=None)
+    assert got["status"] == "OK" and got["observations"][0]["relationship"] == "SUPPORTS"
+    assert router.calls[0][0] == LLMRole.PRIMARY_REASONER and len(router.calls) == 1
+
+
+def test_ungrounded_quote_is_rejected_not_accepted():
+    got = judge_claim_against_sources(CLAIM, SOURCES, FakeRouter(obs("CONTRADICTS", quote="원문에 없는 합성 문장입니다")),
+                                      policy=None)
+    assert got["status"] == "REJECTED" and got["observations"] == [] and got["rejected"][0]["reason"] == "QUOTE_NOT_GROUNDED"
+
+
+def test_empty_observations_is_ok_with_none():
+    got = judge_claim_against_sources(CLAIM, SOURCES, FakeRouter({"observations": []}), policy=None)
+    assert got["status"] == "OK" and got["observations"] == []
+
+
+def test_no_provider_and_model_failure_are_explicit():
+    assert judge_claim_against_sources(CLAIM, SOURCES, FakeRouter({}, available=False), policy=None)["status"] == "NO_PROVIDER"
+    assert judge_claim_against_sources(CLAIM, SOURCES, FakeRouter({}, used=False), policy=None)["status"] == "MODEL_FAILED"
+    assert judge_claim_against_sources(CLAIM, SOURCES, FakeRouter(obs("SUPPORTS"), quarantined=True),
+                                       policy=None)["status"] == "MODEL_FAILED"
