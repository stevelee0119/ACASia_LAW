+++ b/packages/evaluation/nli.py
@@ -0,0 +1,193 @@
+"""Claim–document relation scoring (ContractNLI-style), separate from citation identity/quote quality.
+
+Labels and predictions are supplied from outside; this module never calls a model or reads documents.
+- Three classes: ENTAILMENT / CONTRADICTION / NOT_MENTIONED. NOT_MENTIONED means "the document does not
+  address the hypothesis"; it is never converted into a legal falsity or non-existence claim.
+- A missing, failed or unsupported prediction stays in the denominator as its own outcome (MISSING);
+  it is never treated as NOT_MENTIONED or dropped.
+- Evidence spans are half-open character ranges over the benchmark's own document text. Span scores are
+  character-level precision/recall/F1 against the union of gold spans.
+- One benchmark revision per evaluation; mixing revisions, product versions or runs is rejected.
+- Intervals resample whole documents (and their case_family_id), not individual hypotheses.
+"""
+from __future__ import annotations
+
+import random
+from collections import defaultdict
+from typing import Literal
+
+from pydantic import Field, field_validator, model_validator
+
+from .schemas import Record, Split
+
+NLILabelValue = Literal["ENTAILMENT", "CONTRADICTION", "NOT_MENTIONED"]
+CLASSES = ("ENTAILMENT", "CONTRADICTION", "NOT_MENTIONED")
+OUTCOMES = CLASSES + ("MISSING",)
+
+
+def _spans_ok(spans):
+    previous_end = -1
+    for start, end in spans:
+        if start < 0 or end <= start:
+            raise ValueError("Spans must be nonempty half-open [start, end) ranges")
+        if start < previous_end:
+            raise ValueError("Spans must be sorted and non-overlapping")
+        previous_end = end
+    return spans
+
+
+class NLILabel(Record):
+    schema_version: Literal[1] = 1
+    item_id: str = Field(min_length=1)
+    benchmark_id: str = Field(min_length=1)
+    benchmark_revision: str = Field(min_length=1)
+    document_id: str = Field(min_length=1)
+    case_family_id: str = Field(min_length=1)
+    hypothesis_id: str = Field(min_length=1)
+    split: Split
+    label: NLILabelValue
+    spans: list[tuple[int, int]] = Field(default_factory=list)
+
+    @field_validator("spans")
+    @classmethod
+    def valid_spans(cls, spans):
+        return _spans_ok(sorted(spans))
+
+    @model_validator(mode="after")
+    def spans_follow_label(self):
+        if self.label == "NOT_MENTIONED" and self.spans:
+            raise ValueError("NOT_MENTIONED gold labels carry no evidence spans")
+        return self
+
+
+class NLIPrediction(Record):
+    schema_version: Literal[1] = 1
+    item_id: str = Field(min_length=1)
+    run_id: str = Field(min_length=1)
+    system_version: str = Field(min_length=1)
+    benchmark_revision: str = Field(min_length=1)
+    execution_status: Literal["OK", "ERROR", "UNSUPPORTED"] = "OK"
+    label: NLILabelValue | None = None
+    spans: list[tuple[int, int]] = Field(default_factory=list)
+
+    @field_validator("spans")
+    @classmethod
+    def valid_spans(cls, spans):
+        return _spans_ok(sorted(spans))
+
+    @model_validator(mode="after")
+    def label_follows_status(self):
+        if (self.execution_status == "OK") != (self.label is not None):
+            raise ValueError("Only an OK prediction carries a label; ERROR/UNSUPPORTED carry none")
+        return self
+
+
+def _chars(spans):
+    return {i for start, end in spans for i in range(start, end)}
+
+
+def _ratio(a, b):
+    return a / b if b else None
+
+
+def _index(labels, predictions):
+    known = {label.item_id: label for label in labels}
+    if len(known) != len(labels):
+        raise ValueError("Duplicate label item_id")
+    revisions = {label.benchmark_revision for label in labels} | {p.benchmark_revision for p in predictions}
+    if len(revisions) != 1:
+        raise ValueError("Do not mix benchmark revisions")
+    if len({(p.run_id, p.system_version) for p in predictions}) > 1:
+        raise ValueError("Do not pool different runs or system versions")
+    index = {}
+    for prediction in predictions:
+        if prediction.item_id in index:
+            raise ValueError(f"Duplicate prediction: {prediction.item_id}")
+        if prediction.item_id not in known:
+            raise ValueError(f"Prediction has no label: {prediction.item_id}")
+        index[prediction.item_id] = prediction
+    return index
+
+
+def _outcome(prediction):
+    if prediction is None or prediction.execution_status != "OK":
+        return "MISSING"
+    return prediction.label
+
+
+def _scores(labels, index):
+    confusion = {gold: {out: 0 for out in OUTCOMES} for gold in CLASSES}
+    span_tp = span_fp = span_fn = 0
+    for label in labels:
+        prediction = index.get(label.item_id)
+        outcome = _outcome(prediction)
+        confusion[label.label][outcome] += 1
+        if label.label != "NOT_MENTIONED":
+            gold = _chars(label.spans)
+            found = _chars(prediction.spans) if outcome == label.label else set()
+            span_tp += len(gold & found)
+            span_fp += len(found - gold)
+            span_fn += len(gold - found)
+    per_class = {}
+    for cls in CLASSES:
+        tp = confusion[cls][cls]
+        fp = sum(confusion[g][cls] for g in CLASSES if g != cls)
+        fn = sum(confusion[cls][o] for o in OUTCOMES if o != cls)
+        precision, recall = _ratio(tp, tp + fp), _ratio(tp, tp + fn)
+        f1 = _ratio(2 * tp, 2 * tp + fp + fn)
+        per_class[cls] = {"tp": tp, "fp": fp, "fn": fn, "precision": precision, "recall": recall, "f1": f1}
+    f1s = [per_class[c]["f1"] for c in CLASSES if per_class[c]["f1"] is not None]
+    total = len(labels)
+    missing = sum(confusion[g]["MISSING"] for g in CLASSES)
+    return {
+        "items": total, "confusion": confusion, "per_class": per_class,
+        "macro_f1": sum(f1s) / len(CLASSES) if len(f1s) == len(CLASSES) else None,
+        "accuracy": _ratio(sum(confusion[c][c] for c in CLASSES), total),
+        "missing_or_failed": missing, "completeness": _ratio(total - missing, total),
+        "span": {"precision": _ratio(span_tp, span_tp + span_fp), "recall": _ratio(span_tp, span_tp + span_fn),
+                 "f1": _ratio(2 * span_tp, 2 * span_tp + span_fp + span_fn)},
+    }
+
+
+def evaluate_nli(labels: list[NLILabel], predictions: list[NLIPrediction], *, split: str = "TEST",
+                 bootstrap_samples: int = 1000, seed: int = 0) -> dict:
+    if not 100 <= bootstrap_samples <= 10000:
+        raise ValueError("bootstrap_samples must be between 100 and 10000")
+    families = defaultdict(set)
+    for label in labels:
+        families[label.case_family_id].add(label.split)
+    if any(len(splits) > 1 for splits in families.values()):
+        raise ValueError("Split leakage via case_family_id")
+    index = _index(labels, predictions)
+    selected = sorted((label for label in labels if label.split == split), key=lambda label: label.item_id)
+    if not selected:
+        raise ValueError("Selected evaluation cohort is empty")
+    measured = _scores(selected, index)
+    groups = defaultdict(list)
+    for label in selected:
+        groups[label.case_family_id].append(label)
+    keys = sorted(groups)
+    draws = []
+    rng = random.Random(seed)
+    if len(keys) >= 2:
+        for _ in range(bootstrap_samples):
+            sample = [label for key in rng.choices(keys, k=len(keys)) for label in groups[key]]
+            value = _scores(sample, index)["macro_f1"]
+            if value is not None:
+                draws.append(value)
+    draws.sort()
+    interval = None
+    if draws:
+        pick = lambda q: draws[min(len(draws) - 1, max(0, int(round(q * (len(draws) - 1)))))]
+        interval = {"lower": pick(0.025), "upper": pick(0.975), "valid_resamples": len(draws)}
+    return {
+        "schema_version": 1, "split": split, "benchmark_revision": selected[0].benchmark_revision,
+        "metrics": measured,
+        "uncertainty": {"unit": "case_family_id", "independent_case_families": len(keys),
+                        "macro_f1_percentile_bootstrap_95": interval, "bootstrap_samples": bootstrap_samples, "seed": seed},
+        "claim_scope": "CLAIM_DOCUMENT_RELATION_ONLY",
+        "notice": ("Relation of a hypothesis to the supplied document. Not citation identity, legal validity of an argument, "
+                   "or Korean-law accuracy. NOT_MENTIONED is not a finding that something is false or nonexistent."),
+        "reproducibility": {"system_versions": sorted({p.system_version for p in predictions}),
+                            "run_ids": sorted({p.run_id for p in predictions})},
+    }
