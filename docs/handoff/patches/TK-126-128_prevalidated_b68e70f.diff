+    run = {"id": "r1", "project_id": "p1", "state": "COMPLETED", "progress": 1, "stage_message": "", "document_ids": ["d1"],
+           "scores": {}, "unverified_items": [], "errors": [], "unavailable_sources": [], "input_snapshot": {"scope_revision": 0},
+           "started_at": "2026-10-25T00:00:00"}
