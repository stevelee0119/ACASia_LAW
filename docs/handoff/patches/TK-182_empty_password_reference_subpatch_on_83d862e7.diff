+import pytest
+from reportlab.pdfgen import canvas
+from pypdf import PdfWriter
+from packages.rag_engine.extract import extract
+
+def pdf(tmp_path, password=None):
+    raw=tmp_path/'plain.pdf'
+    c=canvas.Canvas(str(raw));c.drawString(40,700,'Readable reference paragraph');c.showPage();c.save()
+    if password is None:return raw
+    out=tmp_path/'encrypted.pdf';writer=PdfWriter();writer.append(str(raw));writer.encrypt(password,owner_password='generic-owner-password');writer.write(str(out));return out
+
+def test_reference_openable_with_empty_password_is_read(tmp_path):
+    p=pdf(tmp_path,'');result=extract(p,p.name,'application/pdf')
+    assert result['read_pages']==1 and result['chunks']
+    assert not result['partial']
+
+def test_reference_requiring_password_remains_unreadable(tmp_path):
+    p=pdf(tmp_path,'generic-required-password')
+    with pytest.raises(ValueError,match='ENCRYPTED_REFERENCE'):extract(p,p.name,'application/pdf')
+
+def test_plain_reference_remains_readable(tmp_path):
+    p=pdf(tmp_path);result=extract(p,p.name,'application/pdf')
+    assert result['read_pages']==1 and result['chunks']
+    assert not result['partial']
